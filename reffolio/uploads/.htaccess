# 允许访问图片资源，禁止执行任何脚本
Options -ExecCGI -Indexes
RemoveHandler .php .phtml .php3 .php4 .php5 .phar .cgi .pl
RemoveType .php .phtml .php3 .php4 .php5 .phar
<FilesMatch "\.(php|phtml|php3|php4|php5|phar|cgi|pl)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
